function Assets.Apply(image, key)
  local rect = assert(rects[key], "Unknown Fly High UI sprite: " .. key)
  if image:GetAttribute("HUDTextureKey") ~= key then
    image.ImageRectOffset = rect[2]
    image.ImageRectSize = rect[3]
    image.Image = pages[rect[1]]
    image:SetAttribute("HUDTextureKey", key)
  end
  return image.IsLoaded
end

function Assets.Mount(parent, key, fit)
  local image = Instance.new("ImageLabel")
  image.Name = "HUDRaster"
  image.Size = UDim2.fromScale(1, 1)
  image.BackgroundTransparency = 1
  image.BorderSizePixel = 0
  image.Active = false
  image.Selectable = false
  image.ScaleType = fit and Enum.ScaleType.Fit or Enum.ScaleType.Stretch
  image.ZIndex = parent:IsA("GuiObject") and parent.ZIndex or 1
  Assets.Apply(image, key)
  image.Parent = parent
  return image
end

function Assets.Surface(image, key, size)
  local source = rects[key][3]
  if source.X == source.Y then
    image.ScaleType = Enum.ScaleType.Fit
    return
  end
  local edgeX, top, bottom, scale = 26, 24, 32, 0.40
  if source.Y <= 36 then
    edgeX, top, bottom, scale = 16, 14, 16, 0.18
  elseif source.Y == 224 then
    edgeX, top, bottom, scale = 38, 38, 44, 0.26
  end
  image.ScaleType = Enum.ScaleType.Slice
  -- SliceCenter is relative to this sprite's ImageRect, including on a shared texture.
  image.SliceCenter = Rect.new(edgeX, top, source.X - edgeX, source.Y - bottom)
  image.SliceScale = math.max(0.01, math.min(scale, size.X / (2 * edgeX + 1), size.Y / (top + bottom + 1)))
end

function Assets.Letter(label, key, height)
  local sprite = key and "letter_" .. key
  if sprite and not rects[sprite] then sprite = "meter_" .. key end
  local image = label:FindFirstChild("HUDLettering")
  if sprite and rects[sprite] then
    if not image then
      image = Assets.Mount(label, sprite, true)
      image.Name = "HUDLettering"
      image:SetAttribute("FallbackTransparency", label.TextTransparency)
    end
    image.Visible = true
    local loaded = Assets.Apply(image, sprite)
    local size = label.AbsoluteSize
    local glyph = image.ImageRectSize
    local maxHeight = height or (label.TextScaled and size.Y or label.TextSize * 1.32)
    local scale = math.min(size.X / glyph.X, size.Y / glyph.Y, maxHeight / glyph.Y)
    image.Size = UDim2.fromOffset(glyph.X * scale, glyph.Y * scale)
    local alignment = label.TextXAlignment
    local x = alignment == Enum.TextXAlignment.Left and 0 or alignment == Enum.TextXAlignment.Right and 1 or 0.5
    image.AnchorPoint = Vector2.new(x, 0.5)
    image.Position = UDim2.fromScale(x, 0.5)
    image.ZIndex = label.ZIndex + 1
    label.TextTransparency = loaded and 1 or image:GetAttribute("FallbackTransparency")
    local outline = label:FindFirstChildOfClass("UIStroke")
    if outline then outline.Enabled = not loaded end
  elseif image then
    image.Visible = false
    label.TextTransparency = image:GetAttribute("FallbackTransparency")
    local outline = label:FindFirstChildOfClass("UIStroke")
    if outline then outline.Enabled = true end
  end
  return image
end

