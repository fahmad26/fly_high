      widths[i] = heights[i] * size.X / size.Y
    end
    total += widths[i]
  end
  for i, image in run.images do if i > #run.glyphs then image.Visible = false end end
  local size = label.AbsoluteSize
  local scale = math.min(1, size.X / total, size.Y / height)
  local cursor = 0
  for i, width in widths do
    local image = run.images[i]
    if image and heights[i] > 0 then
      image.Position = UDim2.fromOffset(cursor * scale, (height - heights[i]) * scale / 2)
      image.Size = UDim2.fromOffset(width * scale, heights[i] * scale)
      image.ZIndex = label.ZIndex + 1
    end
    cursor += width
  end
  local alignment = label.TextXAlignment
  local x = alignment == Enum.TextXAlignment.Left and 0 or alignment == Enum.TextXAlignment.Right and 1 or 0.5
  run.frame.Size = UDim2.fromOffset(total * scale, height * scale)
  run.frame.Position = UDim2.fromScale(x, 0.5)
  run.frame.AnchorPoint = Vector2.new(x, 0.5)
  run.frame.ZIndex = label.ZIndex + 1
  run.frame.Visible = true
  meterFallback(label, loaded)
  run.loaded, run.height, run.size, run.alignment, run.z = loaded, height, size, alignment, label.ZIndex
  run.width = total * scale
  return loaded and total * scale or 0
end

function Assets.Preload()
  task.spawn(function()
    pcall(function()
      game:GetService("ContentProvider"):PreloadAsync(pages)
    end)
  end)
end

return Assets
