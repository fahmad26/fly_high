local bm=_G.FlyHighBalloonManager local wm=_G.FlyHighWeaponManager local dm=_G.FlyHighDataManager local om=_G.FlyHighObstacleManager local p=game.Players:GetPlayers()[1] local fd local target local wall local registered local saves=0 local saved=dm.Save local f=Instance.new('BindableFunction') f.Name='__AuditFixControl' f.Parent=game.ServerStorage local function part(name,pos,size) local v=Instance.new('Part')v.Name=name v.Anchored=true v.Position=pos v.Size=size v.Parent=workspace return v end local function clear() if target then target:Destroy()end if wall then wall:Destroy()end end f.OnInvoke=function(action,arg) if action=='Launch'then om.Paused=true fd=assert(bm.LaunchBalloon({p},p,workspace.FlyHighLobby.MatchmakingPods.Pod_C.FloorPad.Position,'Pod_C')) for player,item in fd.boarding do bm.FlightAction(player,'BoardReady',item.token)end return true elseif action=='Equip'then fd.root.Anchored=true fd.balloon:PivotTo(fd.balloon:GetPivot()+Vector3.new(0,200,0)) p.Character:PivotTo(fd.balloon.WeaponRack1.CFrame+Vector3.new(0,3,0)) local ok=wm.TryEquip(p,fd.balloon,fd.balloon.WeaponRack1) p.Character.HumanoidRootPart.Anchored=true fd.groundedSince=os.clock()+600 fd.shieldTime=os.clock()+600 return ok==true elseif action=='Target'then clear() local muzzle=wm.held[p].tool.Handle.MuzzleAttachment.WorldPosition local dist=arg or 70 target=Instance.new('Model')target.Name='__AuditFixTarget'target:SetAttribute('IsObstacle',true)target:SetAttribute('Shootable',true)target:SetAttribute('Health',10000)target.Parent=workspace.FlyHighObstacles local t=part('HitProxy',muzzle+Vector3.new(dist,0,0),Vector3.new(10,10,10))t.Parent=target target.PrimaryPart=t wall=part('__AuditFixWall',muzzle+Vector3.new(30,0,0),Vector3.new(3,35,35)) registered={instance=target,shootable=true,effect='Audit',activeAt=os.clock()-1,expires=os.clock()+600,born=os.clock()-1,activated=true,velocity=Vector3.zero,origin=target:GetPivot(),approach=4,minY=-1000,hit={},beams={},spirals={},animated={}}table.insert(om.activeObstacles,registered) return true elseif action=='RemoveWall'then wall.CanQuery=false return true elseif action=='Fake'then for i=#om.activeObstacles,1,-1 do if om.activeObstacles[i]==registered then table.remove(om.activeObstacles,i)end end return true elseif action=='Expiry'then registered.activeAt=os.clock()+600 return true elseif action=='CountSaves'then dm.Save=function(...)saves+=1 return saved(...)end return true elseif action=='Read'then local s=wm.held[p]return {ammo=s.ammo,health=target and target:GetAttribute('Health'),exists=target and target.Parent~=nil,saves=saves,labels=p:GetAttribute('ShowPlayerLabels'),holes=fd.holes} elseif action=='Finish'then dm.Save=saved clear()return true end end
